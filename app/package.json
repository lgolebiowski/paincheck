{
  "name": "paincheck-app",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch server/src/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "lint": "eslint src server/src",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "start": "npm run build && tsx server/src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
